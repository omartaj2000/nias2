# ── MongoDB Atlas ─────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
# Cluster → Connect → Drivers → copy the URI
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Email (Nodemailer / Gmail) ────────────────────────────
# Use a Gmail App Password — NOT your login password
# Google Account → Security → 2-Step Verification → App Passwords
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-app-password-here

# ── Thirdweb ──────────────────────────────────────────────
# Get your client ID from https://thirdweb.com/dashboard/settings/api-keys
# This is public-safe but restrict it to your domain in the dashboard
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your-thirdweb-client-id-here
